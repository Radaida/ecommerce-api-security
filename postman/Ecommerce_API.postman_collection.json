                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response success flag is true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test(\"data is an array\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
