{
  "info": {
    "name": "E-commerce API - Security Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Security headers (check X-Powered-By is absent)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No X-Powered-By', function () { pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "1"
          ]
        }
      }
    },
    {
      "name": "02 Register customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Role is customer', function () { pm.expect(pm.response.json().data.role).to.eql('customer'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Postman User\",\n  \"email\": \"postman{{$timestamp}}@example.com\",\n  \"phone\": \"0790000009\",\n  \"password\": \"test12345\"\n}"
        }
      }
    },
